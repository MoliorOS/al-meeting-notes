# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Notion — single shared integration, used across every target in targets.json.
# Each target's own database still needs to be individually shared with this
# integration in the Notion UI (Connections) — this key alone doesn't grant access.
NOTION_API_KEY=ntn_...

# Which Notion DB(s) to poll and which Drive folder each uploads into is
# per-target config, not an env var — see targets.json.example. Copy it to
# targets.json (gitignored) and edit; TARGETS_FILE overrides the default path.
# TARGETS_FILE=targets.json

# Polling — the service calls Notion on a timer instead of receiving a
# webhook (al-vps has no public ingress). All optional, shown with defaults.
POLL_INTERVAL_SECONDS=120
POLL_LOOKBACK_HOURS=48
POLL_AGE_OUT_HOURS=6

# Google Drive (Service Account) — shared across every target; each target's
# own folder in targets.json still needs to be shared with this account's
# client_email individually.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Webhook signature verification — unused now that the trigger is polling,
# not a webhook. Kept only because the webhook code path stays in the repo
# as a Render-based rollback option (see README "Deploying"). Leave unset.
NOTION_WEBHOOK_SECRET=
